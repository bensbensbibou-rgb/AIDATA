# ============================================
# CONFIGURATION BACNET MCP SERVER
# ============================================

# Interface réseau locale (votre PC)
BACNET__HOST=192.168.1.149
BACNET__PORT=47808

# Dispositif BACnet cible
BACNET__TARGET_HOST=192.168.1.7
BACNET__TARGET_PORT=47808

# Paramètres de découverte
BACNET__DISCOVERY_TIMEOUT=10.0
BACNET__DEVICE_INSTANCE_LOW=0
BACNET__DEVICE_INSTANCE_HIGH=4194302

# Authentification (optionnel)
# Décommentez et définissez une clé si vous voulez sécuriser l'accès
# AUTH__KEY=your_secret_bearer_token_here
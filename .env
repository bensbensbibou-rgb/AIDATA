# MCP BACnet Server Configuration
VITE_PROXY_BACNET_TARGET=http://192.168.1.50:8050
VITE_MCP_BACNET_URL=/proxy/bacnet
# VITE_MCP_BACNET_API_KEY=your_api_key_here

# Distech MCP Server Configuration (via proxy)
VITE_PROXY_DISTECH_TARGET=http://192.168.1.50:8050
VITE_MCP_DISTECH_URL=/proxy/distech
# VITE_MCP_DISTECH_API_KEY=your_api_key_here

# MQTT MCP Server Configuration
VITE_MCP_MQTT_URL=http://localhost:8002
# VITE_MCP_MQTT_API_KEY=your_api_key_here
VITE_MQTT_DEFAULT_HOST=localhost
VITE_MQTT_DEFAULT_PORT=1883

# BACnet Network Configuration (Fallback)
VITE_BACNET_BROADCAST=255.255.255.255
VITE_BACNET_PORT=47808
VITE_BACNET_SCAN_INTERVAL=5000
VITE_GOOGLE_API_KEY=
